# ==========================================
# vbrion Portfolio Server Environment Config
# ==========================================

# Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/vbrion_portfolio

# Email Notification Settings (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

# Company Recipient Address
COMPANY_EMAIL=contact@yourcompany.com
CONTACT_EMAIL=contact@yourcompany.com
SMTP_FROM="vbrion" <your-email@gmail.com>

# Optional AI Assistant / LLM Integration
GEMINI_API_KEY=
